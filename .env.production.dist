# Production settings. On the server copy this file to .env.production and fill in the empty values. Never commit
# .env.production. See docs/deployment.md.

# The address of the blog without https://. A domain such as blog.example.com, or while you have no domain a name that points
# at the IP of the server: 203.0.113.10 becomes 203-0-113-10.sslip.io. The front end, the API and every image address use it,
# so moving to a domain is changing this line.
SITE_ADDRESS=

# The password of the database. Generate it with: openssl rand -hex 24
POSTGRES_PASSWORD=

# The token that lets you write (create, change and delete articles and images). Generate it with: openssl rand -hex 32
ADMIN_TOKEN=

# Only when the API is published at another address than SITE_ADDRESS (for example behind a proxy):
# PUBLIC_URL=https://blog.example.com

# Only when the front end is published at another address than the API: its address (several, separated with commas)
# CORS_ORIGIN=https://www.example.com
