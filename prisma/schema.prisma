generator client {
  provider     = "prisma-client"
  output       = "../prisma/client"
  moduleFormat = "cjs"
  engineType   = "client"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  content     String
  publishedAt DateTime @map("published_at")

  @@index([publishedAt(sort: Desc), id])
  @@map("articles")
}
